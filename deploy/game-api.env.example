# Select the upstream whose usage data powers the board: newapi or sub2api.
USAGE_SOURCE=newapi

# NewAPI origin. Use the production API origin, not the browser dashboard URL.
NEWAPI_BASE_URL=https://api.yhoo.lol

# Create a dedicated read-only admin access token for this adapter.
# Never commit the real value or put it in public/runtime-config.js.
NEWAPI_ACCESS_TOKEN=
NEWAPI_USER_ID=

# Sub2API admin origin and read-only credentials. These are used only when
# USAGE_SOURCE=sub2api. Prefer an admin API key over a long-lived JWT.
SUB2API_BASE_URL=https://ohlaoo.com
SUB2API_ADMIN_API_KEY=
SUB2API_ACCESS_TOKEN=
SUB2API_QUERY_LIMIT=50
SUB2API_TIMEZONE=Asia/Shanghai

HOST=0.0.0.0
PORT=8788
NEWAPI_TIMEOUT_MS=10000
RANKING_CACHE_MS=15000
RANKING_TIMEZONE_OFFSET_MINUTES=480

# Comma-separated browser origins allowed to call the adapter.
CORS_ORIGINS=https://game.example.com,http://127.0.0.1:5173,http://localhost:5173

# Dedicated server-only credential, scoped to this website in ErDai Core.
ERDAI_POINTS_BASE_URL=
ERDAI_POINTS_SITE_TOKEN=
LOTTERY_PREVIEW_ENABLED=0
